{
  "family": "empfehlung",
  "edge": {
    "kind": "dry",
    "line": {
      "color": "#ffffff",
      "alpha": 0.88,
      "width": 1
    },
    "glow": {
      "color": "#ffffff",
      "alpha": 0.16,
      "height": 7
    },
    "haze": {
      "color": "#000000",
      "height": 22,
      "stops": [
        [
          0,
          0.85
        ],
        [
          0.5,
          0.35
        ],
        [
          1,
          0
        ]
      ]
    }
  },
  "card": {
    "frame": { "color": "#ffffff", "width": 2 },
    "glow": {
      "color": "#ffffff",
      "alpha": 0.15,
      "blur": 18
    },
    "roll": true
  },
  "source": {
    "fill": "#ffffff",
    "text": "#000000"
  },
  "tones": {
    "strong": "#e0e0e0"
  }
}
